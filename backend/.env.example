# Copy to backend/.env and edit. Every field in app/config.py can be set here.
# New data release? Put it first:
# SPHEREX_COLLECTIONS=["spherex_dr2","spherex_dr1","spherex_qr3"]
# INCLUDE_DEEP=false
# DATA_SOURCE=s3            # or irsa
# MAX_PARALLEL_REQUESTS=12
# MAX_PARALLEL_IMAGES=8
# MAX_IMAGES_PER_JOB=600
# FETCH_ZODI=false
# CACHE_DIR=./cache
# CACHE_SIZE_GB=20

# AI guide (Google Gemini). Keep the real key only in backend/.env (git-ignored) or a
# server secret; it is never sent to browsers.
# GEMINI_API_KEY=your-key-here
# AI_MODELS=["gemini-3.5-flash","gemini-2.5-flash"]
# AI_PER_CLIENT_PER_10MIN=20
# AI_GLOBAL_PER_HOUR=400
